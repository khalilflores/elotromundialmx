---
import '../styles/global.css';
import ScrollFloat from '../components/ScrollFloat.jsx';
import Crosshair from '../components/Crosshair.jsx';
import CircularText from '../components/CircularText.jsx';
import ScrollVelocity from '../components/ScrollVelocity.jsx';
import Countdown from '../components/Countdown.jsx';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';

const siteName = "El Otro Mundial";
const contactWebhookUrl = "";
const forumWebhookUrl = "";
const supportWebhookUrl = "";

const routeCities = [
	{ city: "Tijuana", date: "Día 04 / Day 04", placeEn: "Border - Northern dirt pitch", image: "/tijuana_pitch_opt.webp" },
	{ city: "San Luis Potosí", date: "Día 15 / Day 15", placeEn: "Highland - Saucito neighborhood", image: "/slp_saucito_opt.webp" },
	{ city: "Oaxaca", date: "Día 26 / Day 26", placeEn: "Deep south - Community mountains", image: "/oaxaca_mountains_opt.webp" }
];
---
<html lang="es" class="scroll-smooth bg-cine-dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <Seo
            title="El Otro Mundial | The Real Mexico Begins Beyond the Stadiums"
            description="55 days across Mexico. Football, Culture, Highway, Community. The World Cup 2026 Cultural Caravan."
            openGraph={{
                basic: {
                    title: "El Otro Mundial | The Real Mexico Begins Beyond the Stadiums",
                    type: "website",
                    image: "https://www.elotromundial.mx/poster-evento-og.jpg",
                    url: "https://www.elotromundial.mx"
                }
            }}
        />
	</head>
	<body class="antialiased min-h-screen flex flex-col text-cine-white cinematic-vignette relative overflow-x-hidden">
		
        <Crosshair client:load color="#FFD700" />

        <div class="fixed inset-0 pointer-events-none z-30 overflow-hidden" id="floating-assets">
            <img src="/peyote_topdown_opt.webp" alt="" role="presentation" class="floating-asset absolute top-1/4 -left-6 md:left-[5%] w-20 md:w-56 opacity-60 mix-blend-screen filter drop-shadow-[0_0_15px_rgba(255,0,255,0.5)] aspect-square rounded-full object-cover" data-speed="0.8" data-rotation="180" />
            <img src="/mushroom_topdown_opt.webp" alt="" role="presentation" class="floating-asset absolute top-[50%] -right-6 md:right-[5%] w-16 md:w-48 opacity-60 mix-blend-screen filter drop-shadow-[0_0_15px_rgba(204,255,0,0.5)] aspect-square rounded-full object-cover" data-speed="1.2" data-rotation="-180" />
            <img src="/flower_topdown_opt.webp" alt="" role="presentation" class="floating-asset absolute top-[120%] -left-4 md:left-[20%] w-20 md:w-52 opacity-60 mix-blend-screen filter drop-shadow-[0_0_15px_rgba(255,215,0,0.5)] aspect-square rounded-full object-cover" data-speed="1.5" data-rotation="90" />
        </div>

		<header class="fixed top-0 left-0 right-0 z-50 py-4 bg-black/40 backdrop-blur-md border-b border-white/10 transition-all duration-300">
			<div class="container mx-auto px-4 lg:px-12 flex justify-between items-center gap-4 relative z-50">
				<div class="brand">
                    <img src="/logo_circ_opt.webp" alt="El Otro Mundial" class="h-12 w-auto opacity-90 drop-shadow-md" width="48" height="48" />
                </div>
				<nav class="hidden md:flex gap-8 text-xl font-bebas tracking-widest uppercase">
					<a href="#caravan" class="hover:text-cine-gold transition-colors text-shadow-sm">The Caravan</a>
					<a href="#join" class="hover:text-cine-gold transition-colors text-shadow-sm">Join</a>
					<a href="#support" class="hover:text-cine-gold transition-colors text-shadow-sm">Support</a>
				</nav>
                <button id="mobile-menu-btn" class="md:hidden text-white p-2" aria-label="Toggle menu">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
			</div>
            <nav id="mobile-menu" class="fixed inset-0 bg-black/80 backdrop-blur-xl z-40 flex flex-col items-center justify-center gap-8 text-3xl font-bebas tracking-widest uppercase transform translate-x-full transition-transform duration-300 md:hidden h-screen w-screen">
                <a href="#caravan" class="mobile-link hover:text-cine-gold transition-colors text-shadow-sm">The Caravan</a>
                <a href="#join" class="mobile-link hover:text-cine-gold transition-colors text-shadow-sm">Join</a>
                <a href="#support" class="mobile-link hover:text-cine-gold transition-colors text-shadow-sm">Support</a>
            </nav>
		</header>

		<main class="relative">
			<section class="relative w-full min-h-screen flex items-center justify-center overflow-hidden border-b border-white/20 pb-24">
				
                <div class="absolute inset-0 w-full h-full pointer-events-none z-0 bg-black">
					<iframe id="youtube-player" class="absolute top-1/2 left-1/2 w-[100vw] h-[56.25vw] min-h-[100vh] min-w-[177.77vh] -translate-x-1/2 -translate-y-1/2 opacity-70 mix-blend-screen scale-105" src="https://www.youtube.com/embed/vFbC1MRuWgo?enablejsapi=1&autoplay=1&mute=1&controls=0&loop=1&playlist=vFbC1MRuWgo&modestbranding=1&playsinline=1&rel=0&showinfo=0" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-cine-dark via-transparent to-cine-dark/80 cinematic-vignette"></div>
				</div>
				
                <button id="toggle-experience-btn" class="absolute bottom-4 right-4 md:bottom-12 md:right-12 z-[60] border-2 border-cine-gold text-cine-gold hover:bg-cine-gold hover:text-black hover:shadow-[0_0_20px_rgba(255,215,0,0.6)] transition-all flex items-center justify-center gap-2 bg-black/80 backdrop-blur-md rounded-full md:rounded-none w-14 h-14 md:w-auto md:h-auto md:px-6 md:py-2">
                    <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                    <span class="btn-text hidden md:block font-bebas text-xl tracking-widest uppercase mt-1">Watch Trailer with Audio</span>
                </button>

				<article id="hero-content" class="relative z-10 flex flex-col items-center text-center w-full px-4 pt-10 transition-opacity duration-1000 ease-in-out">
                    <div class="hero-title-group mb-2 flex flex-col items-center">
                        <ScrollFloat client:load animationDuration={1.2} stagger={0.02} containerClassName="font-bebas text-2xl md:text-4xl text-cine-white tracking-[0.2em] mb-1 opacity-90" as="h1">THE REAL MEXICO</ScrollFloat>
                        <ScrollFloat client:load animationDuration={1.5} stagger={0.04} ease="power4.out" containerClassName="font-bebas text-5xl md:text-7xl lg:text-8xl text-cine-gold leading-none tracking-wider drop-shadow-[0_5px_15px_rgba(0,0,0,0.8)] mt-1">BEGINS BEYOND</ScrollFloat>
                        <ScrollFloat client:load animationDuration={1.5} stagger={0.04} ease="power4.out" containerClassName="font-bebas text-5xl md:text-7xl lg:text-8xl text-cine-gold leading-none tracking-wider drop-shadow-[0_5px_15px_rgba(0,0,0,0.8)] mt-1">THE STADIUMS</ScrollFloat>
                    </div>
                    
                    <div class="hero-subtitle mb-4 flex flex-col items-center gap-1">
                        <span class="font-marker text-xl md:text-3xl neon-text-magenta transform -rotate-2 mb-2">THE MAGICAL MEXICO YOU NEVER SEE IN BROCHURES!</span>
                        <div class="flex items-center gap-3 font-bebas text-lg md:text-2xl tracking-widest">
                            <span class="text-neon-green">★ 55 DAYS ACROSS MEXICO ★</span>
                        </div>
                        <p class="font-barlow text-base md:text-xl text-cine-white/90 tracking-widest uppercase mt-2">
                            Football · Culture · Highway · Community
                        </p>
                    </div>

					<div class="hero-actions flex flex-col items-center gap-2 mt-4">
                        <p class="font-bebas text-xl md:text-2xl tracking-widest text-white">WORLD Cup 2026 CULTURAL CARAVAN</p>
                        <p class="font-bebas text-3xl md:text-5xl text-cine-gold drop-shadow-md">FROM ONLY $3,500 USD</p>
                        <div class="flex flex-col sm:flex-row w-full max-w-[280px] sm:max-w-none justify-center gap-4 mt-3">
                            <a class="btn-epic !py-3 !px-4 !text-xl md:!text-2xl w-full sm:w-auto" href="#support">FUND THE JOURNEY</a>
                            <a class="btn-ghost-epic !py-3 !px-4 !text-xl md:!text-2xl w-full sm:w-auto" href="#caravan">DISCOVER THE ROUTE</a>
                        </div>
                        
                        <div class="mt-4 flex flex-col items-center w-full">
                            <Countdown targetDate="2026-06-30T00:00:00Z" client:load />
                            <a href="#kickstarter" class="group relative inline-flex items-center justify-center font-bebas text-2xl md:text-4xl tracking-widest px-4 md:px-6 py-3 transition-all duration-300 hover:scale-105 mt-2 w-full max-w-[280px] md:max-w-none">
                                <span class="absolute inset-0 bg-transparent border-2 border-[#FF00FF] rounded-none mix-blend-screen opacity-80 group-hover:opacity-100 group-hover:shadow-[0_0_20px_rgba(255,0,255,0.6)]"></span>
                                <span class="relative z-10 flex flex-wrap justify-center gap-x-2 gap-y-0 items-center text-center">
                                    <span class="text-white drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]">RESERVE</span>
                                    <span class="text-[#FF00FF] drop-shadow-[0_0_8px_rgba(255,0,255,0.8)]">ON KICKSTARTER</span>
                                </span>
                            </a>
                        </div>
					</div>
				</article>

                <div class="absolute bottom-12 left-12 z-40 hidden lg:block pointer-events-auto">
                    <CircularText client:load text="EL*OTRO*MUNDIAL*CARAVANA*" onHover="goBonkers" spinDuration={20} />
                </div>
			</section>

            <div class="w-full py-8 overflow-hidden border-y border-white/10 z-20 relative pointer-events-none mix-blend-difference">
                <ScrollVelocity texts={['FOOTBALL • CULTURE • HIGHWAY • COMMUNITY •']} velocity={100} className="font-bebas text-6xl md:text-9xl text-white tracking-widest" client:load />
            </div>

			<div class="container mx-auto px-4 lg:px-12 py-20 md:py-32 space-y-32">
                <section id="caravan" class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="reveal">
                        <h2 class="font-bebas text-5xl md:text-7xl text-cine-white leading-none mb-6">HOSTELS. MARKETS.<br/><span class="text-cine-gold">NEIGHBORHOODS. HIGHWAYS.</span></h2>
                        <p class="font-marker neon-text-green text-3xl md:text-4xl transform -rotate-2 mb-8">The road behind the World Cup!</p>
                        <p class="font-barlow text-xl text-cine-white/80 mb-8 max-w-lg">
                            Get the daily journal. Real-time dispatches, raw video, analog photos, and audio straight from the deepest roads of Mexico. No filters, direct to your WhatsApp.
                        </p>
                    </div>
                    <div class="cinematic-card p-8 md:p-12 reveal">
                        <h3 class="font-bebas text-3xl text-cine-gold mb-6 tracking-widest">JOIN THE CARAVAN</h3>
                        <form id="lead-form" class="space-y-6" method="post" action={contactWebhookUrl || "/"}>
                            <div>
                                <label for="lead-name" class="block font-bebas text-xl text-white mb-2 tracking-wide">Nomad Name</label>
                                <input id="lead-name" name="name" type="text" required class="input-epic" />
                            </div>
                            <div>
                                <label for="lead-contact" class="block font-bebas text-xl text-white mb-2 tracking-wide">WhatsApp / Signal / Email</label>
                                <input id="lead-contact" name="contact" type="text" required class="input-epic" />
                            </div>
                            <input type="hidden" name="source" value="lead-caravan" />
                            <button class="btn-epic w-full" type="submit">SEND THE JOURNAL</button>
                        </form>
                        <p class="mt-4 font-barlow text-lg text-neon-magenta text-center" id="lead-status"></p>
                    </div>
                </section>

                <section id="join" class="space-y-16">
                    <div class="text-center max-w-3xl mx-auto reveal">
                        <h2 class="font-bebas text-6xl md:text-8xl text-cine-white mb-6">THE PITCH IS <span class="text-cine-red">OURS</span></h2>
                        <p class="font-barlow text-2xl text-cine-white/80 uppercase tracking-widest">Physical encounters. Screenings. Street matches.</p>
                        <p class="font-marker neon-text-magenta text-3xl transform rotate-1 mt-4">We are not spectators, we are the movement.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        {routeCities.map((route, i) => (
                            <article class="cinematic-card z-20 flex flex-col reveal floating-card overflow-hidden relative group min-h-[350px]">
                                <div class="absolute inset-0 z-0 opacity-40 group-hover:opacity-70 transition-opacity duration-500">
                                    <img src={route.image} alt={route.city} class="w-full h-full object-cover mix-blend-luminosity group-hover:mix-blend-normal transition-all duration-700 scale-100 group-hover:scale-110" />
                                </div>
                                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent z-10"></div>
                                <div class="relative z-20 flex flex-col h-full gap-4 p-8">
                                    <h3 class="font-bebas text-4xl text-cine-gold drop-shadow-md">{route.city}</h3>
                                    <div class="font-bebas text-xl tracking-widest text-cine-white/80">{route.date}</div>
                                    <p class="font-barlow text-lg text-cine-white/90 uppercase">{route.placeEn}</p>
                                    <button class="btn-ghost-epic text-xl mt-auto w-full forum-cta bg-black/50 backdrop-blur-sm" data-city={route.city} type="button">ATTEND FORUM</button>
                                </div>
                            </article>
                        ))}
                    </div>

                    <div class="cinematic-card p-8 md:p-12 max-w-4xl mx-auto reveal" id="forum-form-container">
                        <h3 class="font-bebas text-4xl text-center mb-8">RESERVE YOUR SPOT</h3>
                        <form id="forum-form" class="grid grid-cols-1 md:grid-cols-2 gap-8" method="post" action={forumWebhookUrl || "/"}>
                            <div class="space-y-2">
                                <label class="font-bebas text-xl tracking-wide">Name</label>
                                <input name="name" type="text" required class="input-epic" />
                            </div>
                            <div class="space-y-2">
                                <label class="font-bebas text-xl tracking-wide">Contact</label>
                                <input name="contact" type="text" required class="input-epic" />
                            </div>
                            <div class="space-y-2 md:col-span-2">
                                <label class="font-bebas text-xl tracking-wide">Select Forum Location</label>
                                <select id="forum-city" name="city" required class="input-epic appearance-none bg-cine-dark">
                                    <option value="">Select a city...</option>
                                    {routeCities.map((route) => <option value={route.city}>{route.city}</option>)}
                                </select>
                            </div>
                            <input type="hidden" name="source" value="forum-reserve" />
                            <div class="md:col-span-2 mt-4">
                                <button class="btn-epic w-full" type="submit">CONFIRM ATTENDANCE</button>
                            </div>
                        </form>
                        <p class="mt-4 font-barlow text-lg text-neon-green text-center" id="forum-status"></p>
                    </div>
                </section>

                <section id="support" class="cinematic-card border-cine-gold/30 p-8 md:p-16 text-center max-w-5xl mx-auto reveal">
                    <h2 class="font-bebas text-6xl md:text-8xl mb-6">KEEP THE CARAVAN <span class="text-cine-gold">MOVING</span></h2>
                    <p class="font-barlow text-2xl text-cine-white/80 uppercase tracking-widest mb-10">100% Independent Documentary. Funded by the community.</p>
                    <p class="font-bebas text-5xl text-cine-white mb-10">FROM ONLY <span class="text-cine-gold">$3,500 USD</span></p>
                    
                    <form id="support-web-form" class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left" method="post" action={supportWebhookUrl || "/"}>
                        <div class="space-y-2">
                            <label class="font-bebas text-xl tracking-wide">Contact</label>
                            <input name="contact" type="text" required class="input-epic" placeholder="WhatsApp or Email" />
                        </div>
                        <div class="space-y-2">
                            <label class="font-bebas text-xl tracking-wide">Support Type</label>
                            <select name="interest" required class="input-epic appearance-none bg-cine-dark">
                                <option value="">Choose an option</option>
                                <option value="buy_trip">Join the Journey ($3,500 USD)</option>
                                <option value="photobook">Pre-order Photobook</option>
                                <option value="sponsor">Brand Sponsorship</option>
                            </select>
                        </div>
                        <div class="md:col-span-2 mt-4">
                            <button class="btn-epic w-full" type="submit">FUND IT NOW</button>
                        </div>
                    </form>
                    <p class="mt-4 font-barlow text-lg text-neon-magenta text-center" id="support-status"></p>
                </section>
			</div>
		</main>

		<footer class="bg-black py-16 border-t border-white/10 relative z-10">
			<div class="container mx-auto px-4 lg:px-12 flex flex-col md:flex-row justify-between items-center gap-8">
                <img src="/logo_circ_opt.webp" alt="El Otro Mundial" class="h-16 w-auto opacity-80" width="64" height="64" />
                <div class="font-barlow uppercase tracking-[0.3em] text-sm text-cine-white/40 text-center md:text-right">
                    El Otro Mundial · Independent Web-Doc<br/>Mexico 2026
                </div>
			</div>
		</footer>

		<script is:inline define:vars={{ contactWebhookUrl, forumWebhookUrl, supportWebhookUrl }}>
			window.contactWebhookUrl = contactWebhookUrl;
			window.forumWebhookUrl = forumWebhookUrl;
			window.supportWebhookUrl = supportWebhookUrl;
		</script>
		<script>
			import Lenis from "lenis";
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			
			gsap.registerPlugin(ScrollTrigger);

            const menuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');
            let isMenuOpen = false;

            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    isMenuOpen = !isMenuOpen;
                    if (isMenuOpen) {
                        mobileMenu.classList.remove('translate-x-full');
                        mobileMenu.classList.add('translate-x-0');
                    } else {
                        mobileMenu.classList.add('translate-x-full');
                        mobileMenu.classList.remove('translate-x-0');
                    }
                });

                mobileLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        isMenuOpen = false;
                        mobileMenu.classList.add('translate-x-full');
                        mobileMenu.classList.remove('translate-x-0');
                    });
                });
            }

			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const lenis = !reducedMotion
				? new Lenis({
					duration: 1.2,
					smoothWheel: true,
					anchors: true
				})
				: null;

			// Epic GSAP Hero Entrance (modified to let ScrollFloat handle the titles)
			const tl = gsap.timeline();
			tl.fromTo(".hero-subtitle span, .hero-subtitle p, .hero-subtitle div",
                { autoAlpha: 0, y: 30 },
                { autoAlpha: 1, y: 0, duration: 1, stagger: 0.2, ease: "power2.out", delay: 1.5 }
            )
            .fromTo(".hero-actions",
                { autoAlpha: 0, y: 20 },
                { autoAlpha: 1, y: 0, duration: 1, ease: "power2.out" },
                "-=0.5"
            );

			const revealItems = gsap.utils.toArray(".reveal");

			if (!reducedMotion) {
				gsap.set(revealItems, { autoAlpha: 0, y: 40 });
				revealItems.forEach((item) => {
					gsap.to(item, {
						autoAlpha: 1,
						y: 0,
						duration: 1.2,
						ease: "power3.out",
						scrollTrigger: {
							trigger: item,
							start: "top 85%",
							toggleActions: "play none none reverse"
						}
					});
				});

                // Floating Assets Parallax
                const assets = gsap.utils.toArray(".floating-asset");
                assets.forEach(asset => {
                    gsap.to(asset, {
                        y: () => -window.innerHeight * parseFloat(asset.getAttribute("data-speed")),
                        rotation: () => parseFloat(asset.getAttribute("data-rotation")),
                        ease: "none",
                        scrollTrigger: {
                            trigger: document.body,
                            start: "top top",
                            end: "bottom top",
                            scrub: true
                        }
                    });
                });

				const floatingCards = gsap.utils.toArray(".floating-card");
				floatingCards.forEach((card, i) => {
					gsap.to(card, {
						y: -10,
						rotation: i % 2 === 0 ? "+=1.5" : "-=1.5",
						yoyo: true,
						repeat: -1,
						ease: "sine.inOut",
						duration: 3 + (i % 3),
						delay: i * 0.2
					});
				});
			} else {
				gsap.set(revealItems, { autoAlpha: 1, y: 0 });
			}

			if (lenis) {
				lenis.on("scroll", ScrollTrigger.update);
				gsap.ticker.add((time) => {
					lenis.raf(time * 1000);
				});
				gsap.ticker.lagSmoothing(0);
			}

			const setFormStatus = (id, message) => {
				const node = document.querySelector(id);
				if (node) {
					node.textContent = message;
				}
			};

			const bindWebhookFallback = (formId, webhook, statusId) => {
				const form = document.querySelector(formId);
				if (!form) return;
				const enabled = Boolean(webhook && webhook.startsWith("https://"));
				if (!enabled) {
					form.addEventListener("submit", (event) => {
						event.preventDefault();
						setFormStatus(statusId, "System ready. Webhook integration required.");
					});
				}
			};

			bindWebhookFallback("#lead-form", window.contactWebhookUrl, "#lead-status");
			bindWebhookFallback("#forum-form", window.forumWebhookUrl, "#forum-status");
			bindWebhookFallback("#support-web-form", window.supportWebhookUrl, "#support-status");

			const forumButtons = document.querySelectorAll(".forum-cta");
			const forumCitySelect = document.querySelector("#forum-city");
			forumButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const city = button.getAttribute("data-city") || "";
					if (forumCitySelect) {
						forumCitySelect.value = city;
					}
					const target = document.querySelector("#forum-form-container");
					if (target) {
						if (lenis && !reducedMotion) {
							lenis.scrollTo(target, { offset: -50, duration: 1.2 });
						} else {
							target.scrollIntoView({ behavior: "smooth", block: "center" });
						}
					}
				});
			});
		</script>
        
        <script is:inline src="https://www.youtube.com/iframe_api"></script>
        <script is:inline>
            var ytPlayer;
            function onYouTubeIframeAPIReady() {
                ytPlayer = new YT.Player('youtube-player', {
                    events: {
                        'onReady': function(event) {
                            console.log("YouTube API Ready");
                        }
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function() {
                const toggleBtn = document.getElementById("toggle-experience-btn");
                const heroContent = document.getElementById("hero-content");
                let isTrailerMode = false;

                if (toggleBtn && heroContent) {
                    toggleBtn.addEventListener("click", () => {
                        isTrailerMode = !isTrailerMode;
                        if (isTrailerMode) {
                            // Hide text, unmute video
                            heroContent.style.opacity = "0";
                            heroContent.style.pointerEvents = "none";
                            toggleBtn.querySelector(".btn-text").textContent = "Back to Website";
                            if (ytPlayer && typeof ytPlayer.unMute === 'function') {
                                ytPlayer.unMute();
                                ytPlayer.setVolume(100);
                            }
                        } else {
                            // Show text, mute video
                            heroContent.style.opacity = "1";
                            heroContent.style.pointerEvents = "auto";
                            toggleBtn.querySelector(".btn-text").textContent = "Watch Trailer with Audio";
                            if (ytPlayer && typeof ytPlayer.mute === 'function') {
                                ytPlayer.mute();
                            }
                        }
                    });
                }
            });
        </script>
	</body>
</html>
