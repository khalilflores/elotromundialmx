                <section id="support" class="cinematic-card border-cine-gold/30 p-8 md:p-16 text-center max-w-5xl mx-auto reveal">
                    <h2 class="font-bebas text-6xl md:text-8xl mb-6">{t.section3Title} <span class="text-cine-gold">{t.section3TitleGold}</span></h2>
                    <p class="font-barlow text-2xl text-cine-white/80 uppercase tracking-widest mb-10">{t.section3Desc}</p>
