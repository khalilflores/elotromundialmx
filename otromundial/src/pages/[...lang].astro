function localizeCity(cityCode, retorno = false) {
  const langCityMap = cityTranslations[currentLang] || cityTranslations.es;
  const name = langCityMap[cityCode] || cityCode;
  return retorno ? `${name}${langCityMap.Retorno || ''}` : name;
}

function formatDuration(hrs, mins) {
  const hourText = hrs > 0 ? `${hrs}${t.hourLabel}` : "";
  const minText = mins > 0 ? ` ${mins}${t.minuteLabel}` : "";
  return `${hourText}${minText}`.trim();
}

function getItineraryImage(from, to) {
  const central = ["CDMX", "Teotihuacan", "Cholula", "Toluca", "Capultitlan", "Cuautla", "Michoacan"];
  const highlands = ["Huautla", "Oaxaca", "SLP", "Zacatecas"];
  const surf = ["Mazunte", "Sayulita"];
  const jungle = ["Juchitan", "SanCristobal", "Palenque", "Xilitla"];
  const cenote = ["Merida", "Campeche", "Guanajuato", "Morelia", "Patzcuaro", "Uruapan"];
  const gulf = ["Xalapa", "ElTajin", "Catemaco"];
  const desert = ["Saltillo", "GomezPalacio"];
  const western = ["Durango"];
  const catorce = ["RealCatorce"];
  
  const target = to === "CDMX" ? from : to;
  
  if (central.includes(target)) return "/central_valley_cinematic.webp";
  if (highlands.includes(target)) return "/oaxaca_sierra_cinematic.webp";
  if (surf.includes(target)) return "/pacific_surf_cinematic.webp";
  if (jungle.includes(target)) return "/jungle_ruins_cinematic.webp";
  if (cenote.includes(target)) return "/cenote_colonial_cinematic.webp";
  if (gulf.includes(target)) return "/gulf_mist_cinematic.webp";
  if (desert.includes(target)) return "/cuatro_cienegas_cinematic.webp";
  if (western.includes(target)) return "/durango_western_cinematic.webp";
  if (catorce.includes(target)) return "/cerro_del_quemado_cinematic.webp";
  
  return "/central_valley_cinematic.webp";
}

const canonicalUrl = currentLang === 'es'
  ? 'https://www.elotromundial.mx/'
  : `https://www.elotromundial.mx/${currentLang}/`;
---
<html lang={currentLang} class="scroll-smooth bg-cine-dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <Seo
            title={t.seoTitle}
            description={t.seoDesc}
            canonical={canonicalUrl}
            openGraph={{
                basic: {
                    title: t.seoTitle,
                    type: "website",
                    image: "https://www.elotromundial.mx/poster-evento-og.jpg",
                    url: canonicalUrl
                }
            }}
        />
	</head>
	<body class="antialiased min-h-screen flex flex-col text-cine-white cinematic-vignette relative overflow-x-hidden">
		
        <!-- Cinematic Intro Screen Overlay -->
        <div id="intro-screen" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-black backdrop-blur-xl transition-opacity duration-1000 ease-out select-none">
            <script is:inline>
                if (sessionStorage.getItem("entered_experience") === "true") {
                    document.getElementById("intro-screen").style.display = "none";
                }
            </script>
            <div class="absolute inset-0 bg-radial-gradient from-transparent to-black/90 pointer-events-none"></div>
            
            <div id="intro-content" class="relative z-10 flex flex-col items-center max-w-md px-6 text-center">
                <!-- Circular Logo with high-end premium pulsing glow -->
                <div class="logo-pulse mb-8 relative">
                    <div class="absolute inset-0 rounded-full bg-cine-gold/20 filter blur-xl animate-pulse"></div>
                    <img src="/logo_circ_opt.webp" alt="El Otro Mundial" class="h-32 w-32 md:h-44 md:w-44 opacity-95 relative z-10 drop-shadow-[0_0_30px_rgba(255,215,0,0.4)]" width="176" height="176" loading="eager" decoding="async" />
                </div>

                <!-- Localized Warning Text -->
                <p class="font-bebas text-lg md:text-2xl text-white/85 tracking-[0.15em] mb-2 uppercase leading-relaxed">
                    {t.introWarning}
                </p>
                <div class="w-12 h-[2px] bg-cine-gold/50 my-4"></div>

                <!-- Localized Action Button -->
                <button id="start-experience-btn" class="btn-epic cursor-pointer text-xl md:text-3xl tracking-[0.2em] font-bebas px-8 py-3.5 bg-transparent border-2 border-cine-gold text-cine-gold hover:bg-cine-gold hover:text-black transition-all duration-300 transform hover:scale-105 select-none focus:outline-none drop-shadow-[0_0_15px_rgba(255,215,0,0.3)]">
                    {t.introEnter}
                </button>

                <!-- Language Selection Flags inside Intro -->
                <div class="mt-8 flex flex-wrap justify-center gap-3 md:gap-4 relative z-20">
                    {locales.map(loc => {
                        const emoji = loc === 'es' ? '🇪🇸' :
                                      loc === 'en' ? '🇬🇧' :
                                      loc === 'fr' ? '🇫🇷' :
                                      loc === 'it' ? '🇮🇹' :
                                      loc === 'de' ? '🇩🇪' :
                                      loc === 'ko' ? '🇰🇷' :
                                      loc === 'ru' ? '🇷🇺' : '';
                        return (
                            <a href={loc === 'es' ? '/' : `/${loc}/`} class={`flex items-center gap-1.5 border px-3 py-1.5 font-bebas text-lg tracking-wider rounded backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-cine-gold hover:text-cine-gold ${loc === currentLang ? 'border-cine-gold text-cine-gold bg-cine-gold/10 shadow-[0_0_10px_rgba(255,215,0,0.2)]' : 'border-white/20 text-white/60 bg-black/40'}`} aria-label={`Switch language to ${loc.toUpperCase()}`}>
                                <span class="text-xl leading-none">{emoji}</span>
                                <span class="pt-0.5">{loc.toUpperCase()}</span>
                            </a>
                        );
                    })}
                </div>
            </div>
        </div>

        <Crosshair client:load color="#FFD700" />

        <div class="fixed inset-0 pointer-events-none z-30 overflow-hidden" id="floating-assets">
