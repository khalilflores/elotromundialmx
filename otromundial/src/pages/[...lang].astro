        {/* Shared Floating Image Hover Preview */}
        <div id="itinerary-preview-wrapper" class="itinerary-preview-wrapper hidden lg:block">
            <img id="itinerary-preview-img" src="" alt="Vista previa del trayecto" loading="lazy" decoding="async" />
