                <a href={currentLang === 'es' ? '/' : `/${currentLang}/`} class="hover:scale-105 transition-transform duration-300" aria-label="El Otro Mundial Home">
                    <img src="/logo_circ_opt.webp" alt="El Otro Mundial" class="h-16 w-auto opacity-80" width="64" height="64" loading="lazy" decoding="async" />
                </a>
                
                <div class="flex flex-wrap justify-center gap-6 text-xs uppercase tracking-wider text-white/50">
                    <a href={currentLang === 'es' ? '/escrow/' : `/${currentLang}/escrow/`} class="hover:text-cine-gold transition-colors duration-200">{t.navEscrowInfo}</a>
                    <a href={currentLang === 'es' ? '/terms/' : `/${currentLang}/terms/`} class="hover:text-cine-gold transition-colors duration-200">{t.navTerms}</a>
                    <a href={currentLang === 'es' ? '/privacy/' : `/${currentLang}/privacy/`} class="hover:text-cine-gold transition-colors duration-200">{t.navPrivacy}</a>
