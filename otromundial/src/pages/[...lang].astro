		<script is:inline define:vars={{ contactWebhookUrl, forumWebhookUrl, supportWebhookUrl, btnTrailerAudio: t.btnTrailerAudio, btnBackWebsite: t.btnBackWebsite, btnMuteVideo: t.btnMuteVideo, btnShowFullRoute: t.btnShowFullRoute, btnShowLess: t.btnShowLess }}>
			window.contactWebhookUrl = contactWebhookUrl;
			window.forumWebhookUrl = forumWebhookUrl;
			window.supportWebhookUrl = supportWebhookUrl;
            window.btnTrailerAudio = btnTrailerAudio;
            window.btnBackWebsite = btnBackWebsite;
            window.btnMuteVideo = btnMuteVideo;
            window.btnShowFullRoute = btnShowFullRoute;
            window.btnShowLess = btnShowLess;
		</script>
		<script>
			import Lenis from "lenis";
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			
			gsap.registerPlugin(ScrollTrigger);



            const menuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');
            let isMenuOpen = false;

            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    isMenuOpen = !isMenuOpen;
                    if (isMenuOpen) {
                        mobileMenu.classList.remove('translate-x-full');
                        mobileMenu.classList.add('translate-x-0');
                    } else {
                        mobileMenu.classList.add('translate-x-full');
                        mobileMenu.classList.remove('translate-x-0');
                    }
                });

                mobileLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        isMenuOpen = false;
                        mobileMenu.classList.add('translate-x-full');
                        mobileMenu.classList.remove('translate-x-0');
                    });
                });
            }

			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const lenis = !reducedMotion
				? new Lenis({
					duration: 1.2,
					smoothWheel: true,
					anchors: true
				})
				: null;

			// Epic GSAP Hero Entrance (modified to let ScrollFloat handle the titles and paused by default until enter click)
			const tl = gsap.timeline({ paused: true });
			tl.fromTo(".hero-subtitle span, .hero-subtitle p, .hero-subtitle div",
                { autoAlpha: 0, y: 30 },
                { autoAlpha: 1, y: 0, duration: 1, stagger: 0.2, ease: "power2.out" }
            )
            .fromTo(".hero-actions",
                { autoAlpha: 0, y: 20 },
                { autoAlpha: 1, y: 0, duration: 1, ease: "power2.out" },
                "-=0.5"
            );

            // Intro Welcome Overlay Click Logic
            const introScreen = document.getElementById("intro-screen");
            const startBtn = document.getElementById("start-experience-btn");

            if (sessionStorage.getItem("entered_experience") === "true") {
                tl.play();
            } else if (introScreen && startBtn) {
                startBtn.addEventListener("click", () => {
                    // Smoothly fade out the welcome screen overlay
                    gsap.to(introScreen, {
                        opacity: 0,
                        duration: 1.2,
                        ease: "power2.out",
                        onComplete: () => {
                            introScreen.style.display = "none";
                            // Play the high-fidelity hero entrance animations when overlay is gone
                            tl.play();
                        }
                    });

                    // Persist that user entered the experience
                    sessionStorage.setItem("entered_experience", "true");

                    // Safely unmute, set volume to 100, and play the YouTube video!
                    if (window.ytPlayer) {
                        if (typeof window.ytPlayer.unMute === 'function') {
                            window.ytPlayer.unMute();
                            window.ytPlayer.setVolume(100);
                        }
                        if (typeof window.ytPlayer.playVideo === 'function') {
                            window.ytPlayer.playVideo();
                        }
                    }
                });
            } else {
                // If intro overlay is not present (fallback), trigger the entrance animation immediately
                tl.play();
            }

			const revealItems = gsap.utils.toArray(".reveal");

			if (!reducedMotion) {
				gsap.set(revealItems, { autoAlpha: 0, y: 40 });
				revealItems.forEach((item) => {
					gsap.to(item, {
						autoAlpha: 1,
						y: 0,
						duration: 1.2,
						ease: "power3.out",
						scrollTrigger: {
							trigger: item,
							start: "top 85%",
							toggleActions: "play none none reverse"
						}
					});
				});

                // Floating Assets Parallax
                const assets = gsap.utils.toArray(".floating-asset");
                assets.forEach(asset => {
                    gsap.to(asset, {
                        y: () => -window.innerHeight * parseFloat(asset.getAttribute("data-speed")),
                        rotation: () => parseFloat(asset.getAttribute("data-rotation")),
                        ease: "none",
                        scrollTrigger: {
                            trigger: document.body,
                            start: "top top",
                            end: "bottom top",
                            scrub: true
                        }
                    });
                });

				const floatingCards = gsap.utils.toArray(".floating-card");
				floatingCards.forEach((card, i) => {
					gsap.to(card, {
						y: -10,
						rotation: i % 2 === 0 ? "+=1.5" : "-=1.5",
						yoyo: true,
						repeat: -1,
						ease: "sine.inOut",
						duration: 3 + (i % 3),
						delay: i * 0.2
					});
				});
			} else {
				gsap.set(revealItems, { autoAlpha: 1, y: 0 });
			}

			if (lenis) {
				lenis.on("scroll", ScrollTrigger.update);
				gsap.ticker.add((time) => {
					lenis.raf(time * 1000);
				});
				gsap.ticker.lagSmoothing(0);
			}

			const setFormStatus = (id, message, isError = false) => {
				const node = document.querySelector(id);
				if (node) {
					node.textContent = message;
					node.style.color = isError ? '#ff4444' : '';
				}
			};

			const bindWebhookFallback = (formId, webhook, statusId) => {
				const form = document.querySelector(formId);
				if (!form) return;
				const enabled = Boolean(webhook && webhook.startsWith("https://"));
				if (!enabled) {
					form.addEventListener("submit", (event) => {
						event.preventDefault();
						setFormStatus(statusId, "Sistema listo. Se requiere configuración de webhook.");
					});
				}
			};

			// --- Formulario de apoyo con Escrow.com ---
			const supportForm = document.querySelector("#support-web-form");
			if (supportForm && window.supportWebhookUrl && (window.supportWebhookUrl.startsWith("https://") || window.supportWebhookUrl.startsWith("/"))) {
				supportForm.addEventListener("submit", async (event) => {
					event.preventDefault();
					const statusNode = document.querySelector("#support-status");
					const submitBtn  = supportForm.querySelector("button[type=submit]");
					const interest   = supportForm.querySelector('select[name="interest"]');
					const contact    = supportForm.querySelector('input[name="contact"]');

					// Validar que el correo sea válido (Escrow lo requiere)
					const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
					const contactVal = contact ? contact.value.trim() : '';
					if (!emailRegex.test(contactVal)) {
						if (statusNode) { statusNode.textContent = 'Para procesar el pago en Escrow, necesitamos tu correo electrónico válido.'; statusNode.style.color = '#ff4444'; }
						return;
					}

					if (statusNode) { statusNode.textContent = 'Creando tu transacción segura en Escrow...'; statusNode.style.color = ''; }
					if (submitBtn)  { submitBtn.disabled = true; submitBtn.textContent = 'Procesando...'; }

					try {
						const res = await fetch(window.supportWebhookUrl, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								buyer_email: contactVal,
								buyer_name:  contactVal,
								tier_id:     interest ? interest.value : 'buy_trip_30d',
							}),
						});

						const data = await res.json();

						if (data.success && data.redirect_url) {
							if (statusNode) statusNode.textContent = '¡Transacción creada! Redirigiendo a Escrow.com...';
							setTimeout(() => { window.location.href = data.redirect_url; }, 1200);
						} else {
							if (statusNode) { statusNode.textContent = data.message || 'Error al crear la transacción.'; statusNode.style.color = '#ff4444'; }
							if (submitBtn)  { submitBtn.disabled = false; submitBtn.textContent = 'APOYAR AHORA'; }
						}
					} catch (err) {
						if (statusNode) { statusNode.textContent = 'Error de red. Por favor intenta de nuevo.'; statusNode.style.color = '#ff4444'; }
						if (submitBtn)  { submitBtn.disabled = false; submitBtn.textContent = 'APOYAR AHORA'; }
					}
				});
			}

			bindWebhookFallback("#lead-form", window.contactWebhookUrl, "#lead-status");
			bindWebhookFallback("#forum-form", window.forumWebhookUrl, "#forum-status");

			const forumButtons = document.querySelectorAll(".forum-cta");
			const forumCitySelect = document.querySelector("#forum-city");
			forumButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const city = button.getAttribute("data-city") || "";
					if (forumCitySelect) {
						forumCitySelect.value = city;
					}
					const target = document.querySelector("#forum-form-container");
					if (target) {
						if (lenis && !reducedMotion) {
							lenis.scrollTo(target, { offset: -50, duration: 1.2 });
						} else {
							target.scrollIntoView({ behavior: "smooth", block: "center" });
						}
					}
				});
			});
			const tierButtons = document.querySelectorAll(".select-tier-btn");
			const supportInterestSelect = document.querySelector('select[name="interest"]');
			tierButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const tierId = button.getAttribute("data-tier") || "";
					if (supportInterestSelect) {
						supportInterestSelect.value = tierId;
					}
					const target = document.querySelector("#support");
					if (target) {
						if (lenis && !reducedMotion) {
							lenis.scrollTo(target, { offset: -50, duration: 1.2 });
						} else {
							target.scrollIntoView({ behavior: "smooth", block: "center" });
						}
					}
				});
			});
            // Timeline Expander Toggler
            const itineraryToggleBtn = document.getElementById("itinerary-toggle-btn");
            const itineraryWrapper = document.getElementById("itinerary-extra-wrapper");
            const itineraryFadeOverlay = document.getElementById("itinerary-fade-overlay");
            let isItineraryExpanded = false;

            if (itineraryToggleBtn && itineraryWrapper && itineraryFadeOverlay) {
                itineraryToggleBtn.addEventListener("click", () => {
                    isItineraryExpanded = !isItineraryExpanded;
                    if (isItineraryExpanded) {
                        itineraryWrapper.classList.add("expanded");
                        itineraryFadeOverlay.classList.add("opacity-0");
                        itineraryToggleBtn.querySelector(".btn-toggle-label").textContent = window.btnShowLess;
                    } else {
                        itineraryWrapper.classList.remove("expanded");
                        itineraryFadeOverlay.classList.remove("opacity-0");
                        itineraryToggleBtn.querySelector(".btn-toggle-label").textContent = window.btnShowFullRoute;

                        // Scroll back to the itinerary section top when collapsing to prevent losing position
                        const itinerarySection = document.getElementById("itinerary");
                        if (itinerarySection) {
                            if (lenis && !reducedMotion) {
                                lenis.scrollTo(itinerarySection, { offset: -50, duration: 1.2 });
                            } else {
                                itinerarySection.scrollIntoView({ behavior: "smooth", block: "start" });
                            }
                        }
                    }

                    // Crucial: refresh ScrollTrigger so GSAP registers new document height
                    setTimeout(() => {
                        ScrollTrigger.refresh();
                    }, 600); // match transition duration
                });
            }

            // Shared Floating Image Hover Reveal Effect using GSAP quickTo
            const hoverWrapper = document.getElementById("itinerary-preview-wrapper");
            const hoverImg = document.getElementById("itinerary-preview-img");
            const itineraryLegItems = document.querySelectorAll(".itinerary-leg-item");

            if (hoverWrapper && hoverImg && itineraryLegItems.length > 0 && !reducedMotion) {
                // We use xPercent: 0 and yPercent: 0 to easily bound the top-left positioning 
                // of the card relative to viewport boundaries without centering-math bias.
                gsap.set(hoverWrapper, { xPercent: 0, yPercent: 0, scale: 0.8, autoAlpha: 0, rotation: 0 });

                const showPreview = gsap.to(hoverWrapper, {
                    autoAlpha: 1,
                    scale: 1,
                    duration: 0.35,
                    ease: "power2.out",
                    paused: true
                });

                const xTo = gsap.quickTo(hoverWrapper, "x", { duration: 0.3, ease: "power3" });
                const yTo = gsap.quickTo(hoverWrapper, "y", { duration: 0.3, ease: "power3" });
                const rotateTo = gsap.quickTo(hoverWrapper, "rotation", { duration: 0.4, ease: "power3" });

                let isHovering = false;
                let lastMouseX = 0;

                // Computes the perfect coordinates to keep the 320x200 hover card fully visible
                // within the screen and positioned completely clear of the text being read.
                const calculateCardPosition = (clientX, clientY) => {
                    const cardWidth = 320;
                    const cardHeight = 200;
                    const padding = 20;
                    const screenWidth = window.innerWidth;
                    const screenHeight = window.innerHeight;

                    // Default: offset card 40px to the right of the cursor (clean and off the text)
                    let x = clientX + 40;
                    // Default: offset card 20px above the cursor
                    let y = clientY - cardHeight - 20;

                    // If it would overflow the right edge, flip it to the left side
                    if (x + cardWidth > screenWidth - padding) {
                        x = clientX - cardWidth - 40;
                    }
                    // Prevent overflow on the left edge
                    if (x < padding) {
                        x = padding;
                    }
                    // If it would overflow the top edge, push it below the cursor
                    if (y < padding) {
                        y = clientY + 40;
                    }
                    // Prevent overflow on the bottom edge
                    if (y + cardHeight > screenHeight - padding) {
                        y = screenHeight - padding - cardHeight;
                    }

                    return { x, y };
                };

                window.addEventListener("mousemove", (e) => {
                    if (!isHovering) return;
                    
                    const pos = calculateCardPosition(e.clientX, e.clientY);
                    xTo(pos.x);
                    yTo(pos.y);

                    // Dynamic tilt calculation
                    const deltaX = e.clientX - lastMouseX;
                    lastMouseX = e.clientX;
                    const rotation = Math.max(-10, Math.min(10, deltaX * 0.3));
                    rotateTo(rotation);
                });

                itineraryLegItems.forEach((item) => {
                    item.addEventListener("mouseenter", (e) => {
                        const imgUrl = item.getAttribute("data-image");
                        if (imgUrl) {
                            hoverImg.src = imgUrl;
                        }
                        isHovering = true;

                        const pos = calculateCardPosition(e.clientX, e.clientY);
                        // Instantly place wrapper at precise coordinates before fading in
                        gsap.set(hoverWrapper, {
                            x: pos.x,
                            y: pos.y,
                            rotation: 0
                        });
                        lastMouseX = e.clientX;

                        showPreview.play();
                    });

                    item.addEventListener("mouseleave", () => {
                        isHovering = false;
                        showPreview.reverse();
                        rotateTo(0);
                    });
                });
            }
		</script>
        
        <script is:inline src="https://www.youtube.com/iframe_api"></script>
        <script is:inline>
            function onYouTubeIframeAPIReady() {
                window.ytPlayer = new YT.Player('youtube-player', {
                    events: {
                        'onReady': function(event) {
                            console.log("YouTube API Ready");
                            if (sessionStorage.getItem("entered_experience") === "true") {
                                if (event.target && typeof event.target.unMute === 'function') {
                                    event.target.unMute();
                                    event.target.setVolume(100);
                                    event.target.playVideo();
                                }
                            }
                        }
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function() {
                const toggleBtn = document.getElementById("toggle-experience-btn");
                const heroContent = document.getElementById("hero-content");
                
                // Audio starts unmuted on enter, and normal landing text is visible
                let isMuted = false;
                let isTrailer = false;

                if (toggleBtn && heroContent) {
                    toggleBtn.addEventListener("click", () => {
                        const player = window.ytPlayer;
                        if (!isMuted && !isTrailer) {
                            // State 1 (Initial): unmuted background -> click to Mute
                            if (player && typeof player.mute === 'function') {
                                player.mute();
                            }
                            isMuted = true;
                            toggleBtn.querySelector(".btn-text").textContent = window.btnTrailerAudio;
                        } else if (isMuted) {
                            // State 2: muted -> click to unmute and enter immersive Trailer Mode
                            if (player && typeof player.unMute === 'function') {
                                player.unMute();
                                player.setVolume(100);
                            }
                            heroContent.style.opacity = "0";
                            heroContent.style.pointerEvents = "none";
                            isMuted = false;
                            isTrailer = true;
                            toggleBtn.querySelector(".btn-text").textContent = window.btnBackWebsite;
                        } else if (!isMuted && isTrailer) {
                            // State 3: unmuted immersive Trailer Mode -> click to return to Website with unmuted audio
                            heroContent.style.opacity = "1";
                            heroContent.style.pointerEvents = "auto";
                            isTrailer = false;
                            toggleBtn.querySelector(".btn-text").textContent = window.btnMuteVideo;
                        }
                    });
                }
            });
        </script>
        <style>
            .logo-pulse {
                animation: breathe 3s ease-in-out infinite alternate;
            }
            @keyframes breathe {
                0% {
                    transform: scale(0.97);
                    filter: brightness(0.9) drop-shadow(0 0 15px rgba(255, 215, 0, 0.15));
                }
                100% {
                    transform: scale(1.03);
                    filter: brightness(1.1) drop-shadow(0 0 35px rgba(255, 215, 0, 0.45));
                }
            }
            #intro-screen {
                background: radial-gradient(circle at center, #111 0%, #000 100%);
                opacity: 1; /* Keep fully opaque to block out the landing page behind it during language load transitions */
            }
            #intro-content {
                opacity: 1; /* Render instantly on first paint to prevent any fade-in lag or background flashing */
            }
            #itinerary-extra-wrapper {
                display: grid;
                grid-template-rows: 0fr;
                transition: grid-template-rows 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease-in-out;
                opacity: 0;
            }
            #itinerary-extra-wrapper.expanded {
                grid-template-rows: 1fr;
                opacity: 1;
            }
            .timeline-gradient-line {
                background: linear-gradient(to bottom, var(--color-cine-gold), var(--color-neon-magenta), var(--color-cine-red));
            }
            .itinerary-preview-wrapper {
                position: fixed;
                width: 320px;
                height: 200px;
                top: 0;
                left: 0;
                pointer-events: none;
                z-index: 100;
                opacity: 0;
                visibility: hidden;
                border-radius: 12px;
                overflow: hidden;
                border: 2px solid rgba(255, 215, 0, 0.4);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 215, 0, 0.2);
                transform-origin: center center;
            }
            .itinerary-preview-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                filter: contrast(1.1) brightness(0.9);
            }
            .itinerary-leg-item {
                will-change: background-color;
            }
        </style>
	</body>
