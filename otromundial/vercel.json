{
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "Accept-Language"
        },
        {
          "key": "No-Vary-Search",
          "value": "key-order, params=(\"utm_source\" \"utm_medium\" \"utm_campaign\" \"utm_content\" \"utm_term\")"
        },
        {
          "key": "Link",
          "value": "</sitemap-index.xml>; rel=\"sitemap\""
        }
      ]
    }
  ]
}
